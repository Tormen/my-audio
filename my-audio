# --------------------------------------------------------------------------
# Output


@dataclass
class Out:
    """Every line the tool prints goes through here: -Q silences the standard
    output, -V adds detail, -D diagnostics. Errors never pass through."""
    quiet: bool = False
    verbose: bool = False
    debug: bool = False
    debug_path: str = ""

    def msg(self, line: str) -> None:
        if not self.quiet:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()

    def det(self, line: str) -> None:
        if self.verbose:
            self.msg(line)

    def dbg(self, line: str) -> None:
        if not self.debug:
            return
        self.msg(f" ~~~ {line}")
        if self.debug_path:
            try:
                with open(self.debug_path, "a") as f:
                    f.write(f"{now()} ~~~ {line}\n")
            except OSError as e:
                err("00001", f"cannot append to the -D file '{self.debug_path}': {e.strerror}")


def now() -> str:
    return time.strftime("%Y-%m-%d %H:%M:%S")


# --------------------------------------------------------------------------
# Audio devices


@dataclass(frozen=True)
class Device:
    id: int
    uid: str
    name: str
    transport: str
    outputs: int     # output streams; a Multi-Output Device can report 0


class AudioError(Exception):
    """CoreAudio refused something; the message says what."""


class Audio:
    """What my-audio needs from the system's audio. CoreAudio is the real one;
    the self-test drives a fake one through the same interface."""

    def devices(self) -> list[Device]:
        raise NotImplementedError

    def default_output(self) -> int | None:
        raise NotImplementedError

    def set_default_output(self, dev: Device) -> None:
        raise NotImplementedError

    def volume(self, dev_id: int) -> float | None:
        raise NotImplementedError

    def muted(self, dev_id: int) -> bool | None:
        raise NotImplementedError

    def listen(self, wake: Callable[[], None]) -> bool:
        """Call `wake` whenever the device list changes; False if refused."""
        raise NotImplementedError


class _Addr(ctypes.Structure):
    _fields_ = [("selector", ctypes.c_uint32), ("scope", ctypes.c_uint32), ("element", ctypes.c_uint32)]


def _fcc(s: str) -> int:
    return int.from_bytes(s.encode("ascii"), "big")


def _unfcc(v: int) -> str:
    return v.to_bytes(4, "big").decode("latin-1").strip() or "?"


_SYSTEM = 1                      # kAudioObjectSystemObject
_GLOB = _fcc("glob")             # kAudioObjectPropertyScopeGlobal
_OUTP = _fcc("outp")             # kAudioObjectPropertyScopeOutput
_UTF8 = 0x08000100               # kCFStringEncodingUTF8
_FRAMEWORKS = "/System/Library/Frameworks"
_LISTENER = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p, ctypes.c_void_p)


class CoreAudio(Audio):
    """The real thing: CoreAudio's AudioObject calls, through ctypes."""

    def __init__(self) -> None:
        self.ca = ctypes.CDLL(f"{_FRAMEWORKS}/CoreAudio.framework/CoreAudio")
        self.cf = ctypes.CDLL(f"{_FRAMEWORKS}/CoreFoundation.framework/CoreFoundation")
        self.tb = ctypes.CDLL(f"{_FRAMEWORKS}/AudioToolbox.framework/AudioToolbox")
        addr = ctypes.POINTER(_Addr)
        u32p = ctypes.POINTER(ctypes.c_uint32)
        self.ca.AudioObjectGetPropertyDataSize.argtypes = [ctypes.c_uint32, addr, ctypes.c_uint32, ctypes.c_void_p, u32p]
        self.ca.AudioObjectGetPropertyData.argtypes = [ctypes.c_uint32, addr, ctypes.c_uint32, ctypes.c_void_p, u32p, ctypes.c_void_p]
        self.ca.AudioObjectSetPropertyData.argtypes = [ctypes.c_uint32, addr, ctypes.c_uint32, ctypes.c_void_p, ctypes.c_uint32, ctypes.c_void_p]
        self.ca.AudioObjectAddPropertyListener.argtypes = [ctypes.c_uint32, addr, _LISTENER, ctypes.c_void_p]
        self.tb.AudioHardwareServiceGetPropertyData.argtypes = [ctypes.c_uint32, addr, ctypes.c_uint32, ctypes.c_void_p, u32p, ctypes.c_void_p]
        for f in (self.ca.AudioObjectGetPropertyDataSize, self.ca.AudioObjectGetPropertyData,
                  self.ca.AudioObjectSetPropertyData, self.ca.AudioObjectAddPropertyListener,
                  self.tb.AudioHardwareServiceGetPropertyData):
            f.restype = ctypes.c_int32
        self.cf.CFStringGetCString.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long, ctypes.c_uint32]
        self.cf.CFStringGetCString.restype = ctypes.c_bool
        self.cf.CFRelease.argtypes = [ctypes.c_void_p]
        self._keep: list[object] = []      # the listener callback must outlive the call

    def _size(self, obj: int, sel: str, scope: int = _GLOB) -> int | None:
        a = _Addr(_fcc(sel), scope, 0)
        n = ctypes.c_uint32(0)
        rc = int(self.ca.AudioObjectGetPropertyDataSize(obj, ctypes.byref(a), 0, None, ctypes.byref(n)))
        return n.value if rc == 0 else None

    def _u32(self, obj: int, sel: str, scope: int = _GLOB) -> int | None:
        a = _Addr(_fcc(sel), scope, 0)
        v = ctypes.c_uint32(0)
        n = ctypes.c_uint32(ctypes.sizeof(v))
        rc = int(self.ca.AudioObjectGetPropertyData(obj, ctypes.byref(a), 0, None, ctypes.byref(n), ctypes.byref(v)))
        return v.value if rc == 0 else None

    def _str(self, obj: int, sel: str) -> str:
        a = _Addr(_fcc(sel), _GLOB, 0)
        ref = ctypes.c_void_p(None)
        n = ctypes.c_uint32(ctypes.sizeof(ref))
        rc = int(self.ca.AudioObjectGetPropertyData(obj, ctypes.byref(a), 0, None, ctypes.byref(n), ctypes.byref(ref)))
        if rc != 0 or not ref.value:
            return ""
        buf = ctypes.create_string_buffer(1024)
        ok = bool(self.cf.CFStringGetCString(ref.value, buf, len(buf), _UTF8))
        self.cf.CFRelease(ref.value)
        return buf.value.decode("utf-8", "replace") if ok else ""

    def devices(self) -> list[Device]:
        size = self._size(_SYSTEM, "dev#")
        if size is None:
            raise AudioError("CoreAudio does not list its devices")
        ids = (ctypes.c_uint32 * (size // 4))()
        a = _Addr(_fcc("dev#"), _GLOB, 0)
        n = ctypes.c_uint32(size)
        rc = int(self.ca.AudioObjectGetPropertyData(_SYSTEM, ctypes.byref(a), 0, None, ctypes.byref(n), ids))
        if rc != 0:
            raise AudioError(f"CoreAudio does not list its devices [OSStatus {rc}]")
        out: list[Device] = []
        for i in list(ids)[: n.value // 4]:
            tran = self._u32(i, "tran")
            out.append(Device(id=int(i), uid=self._str(i, "uid "), name=self._str(i, "lnam"),
                              transport=_unfcc(tran) if tran is not None else "?",
                              outputs=(self._size(i, "stm#", _OUTP) or 0) // 4))
        return out

    def default_output(self) -> int | None:
        return self._u32(_SYSTEM, "dOut")

    def set_default_output(self, dev: Device) -> None:
        a = _Addr(_fcc("dOut"), _GLOB, 0)
        v = ctypes.c_uint32(dev.id)
        rc = int(self.ca.AudioObjectSetPropertyData(_SYSTEM, ctypes.byref(a), 0, None, ctypes.sizeof(v), ctypes.byref(v)))
        if rc != 0:
            raise AudioError(f"CoreAudio refused '{dev.name}' as the default output [OSStatus {rc}]")

    def volume(self, dev_id: int) -> float | None:
        # the main volume as the menu bar shows it (VirtualMainVolume)
        a = _Addr(_fcc("vmvc"), _OUTP, 0)
        v = ctypes.c_float(0.0)
        n = ctypes.c_uint32(ctypes.sizeof(v))
        rc = int(self.tb.AudioHardwareServiceGetPropertyData(dev_id, ctypes.byref(a), 0, None, ctypes.byref(n), ctypes.byref(v)))
        return float(v.value) if rc == 0 else None

    def muted(self, dev_id: int) -> bool | None:
        m = self._u32(dev_id, "mute", _OUTP)
        return None if m is None else m != 0

    def listen(self, wake: Callable[[], None]) -> bool:
        # NULL as the HAL's run loop: notifications arrive on CoreAudio's own
        # thread, so no run loop is needed here
        a = _Addr(_fcc("rnlp"), _GLOB, 0)
        null = ctypes.c_void_p(None)
        self.ca.AudioObjectSetPropertyData(_SYSTEM, ctypes.byref(a), 0, None, ctypes.sizeof(null), ctypes.byref(null))

        def cb(_obj: int, _n: int, _addrs: int | None, _data: int | None) -> int:
            wake()
            return 0
        proc = _LISTENER(cb)
        self._keep.append(proc)
        b = _Addr(_fcc("dev#"), _GLOB, 0)
        return int(self.ca.AudioObjectAddPropertyListener(_SYSTEM, ctypes.byref(b), proc, None)) == 0


def device_from_json(d: dict[str, object]) -> Device:
    """One device of the fake audio's JSON; a missing field raises KeyError."""
    i, outputs = d["id"], d["outputs"]
    if not isinstance(i, int) or not isinstance(outputs, int):
        raise AudioError(f"device {d!r}: id and outputs must be numbers")
    return Device(id=i, uid=str(d["uid"]), name=str(d["name"]), transport=str(d["tran"]), outputs=outputs)


class FakeAudio(Audio):
    """The self-test's audio: a JSON file, re-read on every call, so a test
    can plug and unplug between two calls. Selected by $MY_AUDIO_FAKE."""

    def __init__(self, path: str) -> None:
        self.path = path

    def _load(self) -> dict[str, object]:
        with open(self.path) as f:
            data: dict[str, object] = json.load(f)
        return data

    def _raw(self) -> list[dict[str, object]]:
        raw = self._load().get("devices")
        if not isinstance(raw, list):
            raise AudioError(f"{self.path}: no device list")
        return cast("list[dict[str, object]]", raw)

    def devices(self) -> list[Device]:
        return [device_from_json(d) for d in self._raw()]

    def default_output(self) -> int | None:
        v = self._load().get("default")
        return v if isinstance(v, int) else None

    def set_default_output(self, dev: Device) -> None:
        data = self._load()
        data["default"] = dev.id
        sets = data.get("sets", 0)
        data["sets"] = (sets if isinstance(sets, int) else 0) + 1
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, self.path)

    def _field(self, dev_id: int, key: str) -> object:
        return next((d.get(key) for d in self._raw() if d.get("id") == dev_id), None)

    def volume(self, dev_id: int) -> float | None:
        v = self._field(dev_id, "volume")
        return float(v) if isinstance(v, (int, float)) else None

    def muted(self, dev_id: int) -> bool | None:
        v = self._field(dev_id, "mute")
        return v if isinstance(v, bool) else None

    def listen(self, wake: Callable[[], None]) -> bool:
        return False


def audio() -> Audio:
    fake = os.environ.get("MY_AUDIO_FAKE", "")
    return FakeAudio(fake) if fake else CoreAudio()


# --------------------------------------------------------------------------
# Rules


@dataclass(frozen=True)
class Rule:
    index: int        # 1-based, in AUDIO_RULES order
    text: str         # the rule as written, comment stripped
    transport: str
    glob: str
    target: str       # a device name, or "@" for the matched device

    def matches(self, d: Device) -> bool:
        if self.transport != "*" and d.transport != self.transport:
            return False
        if not fnmatch.fnmatchcase(d.name, self.glob):
            return False
        return self.target != "@" or d.outputs > 0   # '@' must be playable


def parse_rules(text: str) -> list[Rule]:
    """AUDIO_RULES -> rules; ValueError names the line that is wrong."""
    rules: list[Rule] = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw
        for i, ch in enumerate(raw):    # a comment starts at '#' after a blank, or first
            if ch == "#" and (i == 0 or raw[i - 1] in " \t"):
                line = raw[:i]
                break
        line = line.strip()
        if not line:
            continue
        left, sep, target = line.partition("=>")
        if not sep:
            raise ValueError(f"line {n} of AUDIO_RULES has no '=>': '{line}'")
        transport, sep2, glob = left.strip().partition(":")
        transport, glob, target = transport.strip().lower(), glob.strip(), target.strip()
        if not sep2 or not glob:
            raise ValueError(f"line {n} of AUDIO_RULES: '{left.strip()}' is not <transport>:<device-name glob>")
        if transport != "*" and transport not in TRANSPORTS:
            raise ValueError(f"line {n} of AUDIO_RULES: unknown transport '{transport}' "
                             f"(known: {' '.join(TRANSPORTS)}, or *)")
        if not target:
            raise ValueError(f"line {n} of AUDIO_RULES has no target after '=>'")
        rules.append(Rule(index=len(rules) + 1, text=" ".join(line.split()),
                          transport=transport, glob=glob, target=target))
    return rules


@dataclass(frozen=True)
class Decision:
    target: str | None          # the output the rules want; None = leave it
    rule: Rule | None           # the rule that decided; None = the fallback
    matched: Device | None      # the device that made the rule match

    def why(self) -> str:
        if self.rule is None:
            return "no rule matches: " + ("OUTPUT_FALLBACK" if self.target else "left as is")
        m = f" -- '{self.matched.name}' present" if self.matched else ""
        return f"rule {self.rule.index}: {self.rule.text}{m}"


def decide(rules: Sequence[Rule], fallback: str, devices: Sequence[Device]) -> Decision:
    """The first rule with a present device wins; else the fallback."""
    for r in rules:
        for d in devices:
            if r.matches(d):
                return Decision(target=d.name if r.target == "@" else r.target, rule=r, matched=d)
    return Decision(target=fallback or None, rule=None, matched=None)


