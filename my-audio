    if sys.platform != "darwin":
        t.ok(True, "not macOS: skipped")
        return
    a = CoreAudio()
    devs = a.devices()
    d = a.default_output()
    t.ok(len(devs) > 0 and any(x.id == d for x in devs) and all(x.uid for x in devs),
         f"the real CoreAudio lists {len(devs)} device(s), the default among them (read-only)")


def t_guard(t: T) -> None:
    defined = sorted(n for n, v in globals().items() if n.startswith("t_") and callable(v))
    listed = sorted(fn.__name__ for _title, fn in TESTS)
    t.ok(defined == listed, f"every test function is in the run list [{len(defined)} defined, {len(listed)} listed]")


