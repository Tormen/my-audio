def t_manual_sticks(t: T) -> None:
    t.fake([SPEAKERS, MULTI, BT], 1)
    a = FakeAudio(t.path("audio.json"))
    cfg = t.cfg(RULES)
    out = Out(quiet=True)
    prev = watch_step(a, cfg, out, None)
    t.ok(t.default() == 2, "first look: the rules applied")
    a.set_default_output(Device(1, "uid-1", "Speakers", "bltn", 2))          # the user, by hand
    prev = watch_step(a, cfg, out, prev)
    prev = watch_step(a, cfg, out, prev)
    t.ok(t.default() == 1, "device set unchanged: the hand-chosen output stays, twice over")
    t.fake([SPEAKERS, MULTI], 1)
    prev = watch_step(a, cfg, out, prev)
    t.fake([SPEAKERS, MULTI, BT], 1)
    watch_step(a, cfg, out, prev)
    t.ok(t.default() == 2, "unplugged and plugged again: the rules apply again")


def t_missing_target(t: T) -> None:
    t.fake([SPEAKERS, BT], 1)
    a = FakeAudio(t.path("audio.json"))
    try:
        new = watch_step(a, t.cfg(RULES), Out(quiet=True), None)
        t.ok(len(new) == 2 and t.default() == 1, "target not present: reported, output untouched, the loop goes on")
    except BaseException as e:
        t.ok(False, f"a missing target must not end the loop: {type(e).__name__}")
    t.conf(RULES)
    rc, so, se = t.cli("apply")
    t.ok(rc == 1 and "ERROR 00014" in se and "not a present device" in se and so == "",
         f"`apply` with the target missing: ERROR line, exit 1 [rc {rc}]")


