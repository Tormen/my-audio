def t_config_search(t: T) -> None:
    old = os.environ.get("LINKS")
    os.environ["LINKS"] = t.root
    try:
        s = config_search_paths()
        t.ok(s[:2] == [f"{t.root}/default/my-audio.conf", f"{t.root}/default/my-audio"],
             "/LINKS/default first, .conf before the bare name, and $LINKS followed")
        os.makedirs(f"{t.root}/global/etc/default")
        offer = config_offer()
        t.ok(len(offer) == 3 and "global/etc/default/my-audio.conf" in offer[0],
             f"the offer: site first, written into global/, never into the default/ farm [{len(offer)}]")
        t.ok(all("my-rollout" not in o or "global/" in o for o in offer), "only the site line needs my-rollout")
    finally:
        if old is None:
            del os.environ["LINKS"]
        else:
            os.environ["LINKS"] = old
    t.ok(f"/etc/{NAME}.conf" in config_search_paths() and os.path.expanduser(f"~/.{NAME}.conf")
         in config_search_paths(), "every offered place is one the search reads")


