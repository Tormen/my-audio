def err(code: str, msg: str = "Please fix.", exit_code: int = 1) -> NoReturn:
    """Print `ERROR <code> [<exit>]: <msg>` to stderr and exit."""
    sys.stderr.write(f"ERROR {code} [{exit_code}]: {msg}\n")
    sys.stderr.flush()
    sys.exit(exit_code)


def error_line(code: str, msg: str) -> None:
    """The same ERROR line, for a loop that must go on after it (watch)."""
    sys.stderr.write(f"ERROR {code}: {msg}\n")
