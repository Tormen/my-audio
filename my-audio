def t_install(t: T) -> None:
    t.conf(RULES)
    rc, so, se = t.cli("install")
    plist = t.path("Library/LaunchAgents/test.my-audio.plist")
    t.ok(rc == 0 and os.path.isfile(plist) and "installed test.my-audio" in so, f"install writes and loads [rc {rc}] {se.strip()}")
    with open(plist, "rb") as f:
        d = cast("dict[str, object]", plistlib.load(f))
    args = cast("list[str]", d.get("ProgramArguments", []))
    t.ok(args[:1] == [sys.executable] and args[-3:-1] == ["watch", "--config"]
         and d.get("LimitLoadToSessionType") == "Aqua", "the plist runs `watch` with the Python of `install`")
    rc, so, _se = t.cli("install")
    t.ok(rc == 0 and "already installed" in so, "a second install changes nothing")
    with open(plist, "rb") as f:
        lines = f.read().splitlines()
    t.ok(lines[2].startswith(b"<!-- installed by my-audio install (") and b": generated, build " in lines[2],
         f"the plist says who installed it, when and how: {lines[2][:70]!r}")
    with open(plist, "wb") as f:
        f.write(b"\n".join(ln if not ln.startswith(INSTALLED_BY) else
                           ln.replace(b", 20", b", 1999-01-01 00:00 +0000, 20", 1) for ln in lines) + b"\n")
    rc, so, _se = t.cli("install")
    t.ok(rc == 0 and "already installed" in so, "installed earlier, same job: not installed again")
    with open(plist, "wb") as f:
        f.write(b"\n".join(ln for ln in lines if not ln.startswith(INSTALLED_BY)) + b"\n")
    rc, so, _se = t.cli("install")
    t.ok(rc == 0 and "the plist differed" in so, "installed without the installer line: installed again")
    os.remove(t.path("loaded"))
    rc, so, _se = t.cli("install")
    t.ok(rc == 0 and "loaded again: the plist was right" in so and "differed" not in so,
         f"the same plist, not loaded: says it was only loaded again -- {so.strip()[:90]}")


def t_uninstall_guard(t: T) -> None:
    t.conf(RULES)
    t.cli("install")
    plist = t.path("Library/LaunchAgents/test.my-audio.plist")
    rc, so, _se = t.cli("uninstall")
    t.ok(rc == 0 and os.path.isfile(plist) and os.path.exists(t.path("loaded")) and "would unload" in so,
         "uninstall without go only says what it would do")
    rc, so, _se = t.cli("uninstall", "go")
    t.ok(rc == 0 and not os.path.exists(plist) and not os.path.exists(t.path("loaded")),
         "uninstall go unloads and removes")
    rc, so, _se = t.cli("uninstall", "go")
    t.ok(rc == 0 and "nothing to remove" in so, "and a second one finds nothing")


def t_sigint(t: T) -> None:
    t.fake([SPEAKERS, MULTI], 1)
    t.conf(RULES)
    e = {**os.environ, "MY_AUDIO_CONFIG": t.path("my-audio.conf"), "MY_AUDIO_FAKE": t.path("audio.json")}
    p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "watch"], stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, stdin=subprocess.DEVNULL, env=e, text=True)
    assert p.stdout is not None
    first = p.stdout.readline()
    p.send_signal(signal.SIGINT)
    so, se = p.communicate(timeout=20)
    t.ok("watching" in first, "watch is running")
    t.ok(p.returncode == 130 and "interrupted (Ctrl-C)" in se and "Traceback" not in se + so
         and len(se.strip().splitlines()) == 1, f"Ctrl-C: exit 130, one line, no traceback [rc {p.returncode}]")
    p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "watch"], stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, stdin=subprocess.DEVNULL, env=e, text=True)
    assert p.stdout is not None
    p.stdout.readline()
    p.send_signal(signal.SIGTERM)
    so, se = p.communicate(timeout=20)
    t.ok(p.returncode == 0 and "stopped (SIGTERM)" in so, f"SIGTERM (launchd): a clean stop [rc {p.returncode}]")


