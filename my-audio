def t_create_config(t: T) -> None:
    rc, so, _se = t.cli("--create-config")
    p = t.path("default.conf")
    with open(p, "w") as f:
        f.write(so)
    c = load_config(p, True)
    t.ok(rc == 0 and len(c.rules) == 3 and c.label == f"local.{NAME}", "the default config loads cleanly")
    home = os.path.expanduser("~")
    t.ok(home not in so and "/Users/" not in so and 'LAUNCHD_LABEL="local.' in so,
         "the default config is neutral: no home path, the local. label")
    rc2, _so, se = t.cli("--create-config", p)
    with open(p) as f:
        same = f.read() == so
    t.ok(rc2 == 1 and "ERROR 00012" in se and same, f"--create-config FILE never overwrites [rc {rc2}]")
    rc3, so3, _se = t.cli(f"--create-config={t.path('new.conf')}")
    t.ok(rc3 == 0 and os.path.isfile(t.path("new.conf")) and "wrote" in so3, "--create-config=FILE writes a new one")


