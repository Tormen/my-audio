# Config


@dataclass(frozen=True)
class Config:
    path: str
    explicit: bool        # from --config / $MY_AUDIO_CONFIG: the agent must be told
    rules: list[Rule]
    fallback: str
    recheck: float
    settle: float
    label: str
    log_file: str


def links_root() -> str:
    return os.environ.get("LINKS") or "/LINKS"


def config_search_paths() -> list[str]:
    """Where the config is looked for, in order -- the one list the search
    and the offer both use."""
    d = f"{links_root()}/default"
    return [f"{d}/{NAME}.conf", f"{d}/{NAME}", os.path.expanduser(f"~/.{NAME}.conf"),
            f"/etc/{NAME}.conf", f"/usr/local/etc/{NAME}.conf"]


def config_offer() -> list[str]:
    """Paste-ready lines to create a config, most common place first; each
    one checked to be READ by the search, so the offer cannot drift."""
    search = config_search_paths()
    site = f"{links_root()}/global/etc/default"
    cand: list[tuple[str, str, str]] = []     # (write here, read there, note)
    if os.path.isdir(site):
        cand.append((f"{site}/{NAME}.conf", f"{links_root()}/default/{NAME}.conf",
                     "as root; then `my-rollout go` links it"))
    cand.append((f"/etc/{NAME}.conf", f"/etc/{NAME}.conf", "as root"))
    home = os.path.expanduser(f"~/.{NAME}.conf")
    cand.append((home, home, ""))
    return [f"        > {NAME} --create-config > {w}" + (f"   ({note})" if note else "")
            for w, r, note in cand if r in search]


def find_config(explicit: str) -> tuple[str, bool]:
    if explicit:
        return explicit, True
    env = os.environ.get("MY_AUDIO_CONFIG", "")
    if env:
        return env, True
    for p in config_search_paths():
        if os.path.isfile(p):
            return p, False
    sys.stderr.write(f"!!! {NAME} needs a config: the rules are yours to write.\n"
                     f"--> no config found -- write one, most common place first "
                     f"(`{NAME} -h` has the search order):\n" + "\n".join(config_offer()) + "\n")
    err("00002", "no config found", 2)


def load_config(path: str, explicit: bool) -> Config:
    """Source the config with a POSIX shell and read the keys back."""
    if not os.path.isfile(path):
        err("00003", f"config '{path}' does not exist")
    if not os.access(path, os.R_OK):
        err("00004", f"config '{path}' is not readable")
    sh = "/bin/dash" if os.path.exists("/bin/dash") else "/bin/sh"
    script = ('. "$1" >/dev/null || exit 3; shift; '
              'for k; do eval "s=\\${$k+1} v=\\${$k-}"; printf "%s\\0%s\\0" "${s:-0}" "$v"; done')
    p = subprocess.run([sh, "-c", script, NAME, path, *CONFIG_KEYS], capture_output=True, text=True)
    if p.returncode != 0:
        err("00005", f"config '{path}' does not source cleanly [rc {p.returncode}]: "
                     f"{p.stderr.strip() or 'no message'}")
    parts = p.stdout.split("\0")
    vals: dict[str, str] = {}
    for i, k in enumerate(CONFIG_KEYS):
        if parts[2 * i] != "1":
            err("00006", f"config '{path}' does not set {k} -- `{NAME} --create-config` shows it")
        vals[k] = parts[2 * i + 1]
    try:
        rules = parse_rules(vals["AUDIO_RULES"])
    except ValueError as e:
        err("00007", f"config '{path}': {e}")
    try:
        recheck = float(vals["RECHECK_INTERVAL"])
        settle = float(vals["SETTLE_TIME"])
    except ValueError:
        err("00008", f"config '{path}': RECHECK_INTERVAL and SETTLE_TIME are seconds, got "
                     f"'{vals['RECHECK_INTERVAL']}' and '{vals['SETTLE_TIME']}'")
    if recheck <= 0 or settle < 0:
        err("00009", f"config '{path}': RECHECK_INTERVAL must be > 0 and SETTLE_TIME >= 0 "
                     f"[{recheck}, {settle}]")
    label = vals["LAUNCHD_LABEL"]
    if not label or "/" in label or " " in label:
        err("00010", f"config '{path}': LAUNCHD_LABEL must be one word without '/', got '{label}'")
    if not vals["LOG_FILE"].startswith("/"):
        err("00011", f"config '{path}': LOG_FILE must be an absolute path, got '{vals['LOG_FILE']}'")
    TRACE_DIR[0] = os.path.dirname(vals["LOG_FILE"])
    return Config(path=path, explicit=explicit, rules=rules, fallback=vals["OUTPUT_FALLBACK"],
                  recheck=recheck, settle=settle, label=label, log_file=vals["LOG_FILE"])


def create_config(target: str) -> int:
    if not target:
        sys.stdout.write(default_config())
        return 0
    try:
        with open(target, "x") as f:
            f.write(default_config())
    except FileExistsError:
        err("00012", f"'{target}' exists -- never overwritten; compare with "
                     f"`{NAME} --create-config | diff - {target}`")
    except OSError as e:
        err("00013", f"cannot write '{target}': {e.strerror}")
    sys.stdout.write(f" >>> wrote the default config to {target}\n")
    return 0


# --------------------------------------------------------------------------
# Doing it


def by_id(devices: Sequence[Device], dev_id: int | None) -> Device | None:
    return next((d for d in devices if d.id == dev_id), None)


def apply_rules(a: Audio, cfg: Config, out: Out, devices: Sequence[Device], stamp: str = "") -> bool:
    """Switch the default output to what the rules want. False when that
    cannot be done -- reported, never raised: `watch` goes on after it."""
    dec = decide(cfg.rules, cfg.fallback, devices)
    cur = by_id(devices, a.default_output())
    cur_name = cur.name if cur else "?"
    out.dbg(f"decided: target={dec.target!r} by {dec.why()}; current={cur_name!r}")
    if dec.target is None:
        out.msg(f" >>> {stamp}output: {cur_name}  ({dec.why()})")
        return True
    # a target is found by NAME only: a Multi-Output Device can report 0
    # output streams and is still the right target
    want = next((d for d in devices if d.name == dec.target), None)
    if want is None:
        error_line("00014", f"target '{dec.target}' is not a present device ({dec.why()}) -- "
                            f"`{NAME} -V` lists them")
        return False
    if cur is not None and cur.id == want.id:
        out.msg(f" >>> {stamp}output: {want.name}  (unchanged; {dec.why()})")
        return True
    try:
        a.set_default_output(want)
    except AudioError as e:
        error_line("00015", str(e))
        return False
    out.msg(f" >>> {stamp}output -> {want.name}  (was {cur_name}; {dec.why()})")
    return True


def watch_step(a: Audio, cfg: Config, out: Out, prev: frozenset[str] | None) -> frozenset[str]:
    """One look at the devices: apply the rules only when the set of present
    devices differs from `prev` (None: the first look). Returns the new set."""
    devices = a.devices()
    cur = frozenset(d.uid for d in devices)
    if cur == prev:
        out.dbg(f"device set unchanged ({len(cur)} devices): nothing to do")
        return cur
    stamp = f"{now()} "
    if prev is None:
        out.msg(f" >>> {stamp}start: {len(devices)} devices")
    else:
        names = {d.uid: d.name for d in devices}
        gone = sorted(prev - cur)
        came = sorted(cur - prev)
        out.msg(f" >>> {stamp}devices changed: "
                + " ".join([f"+{names.get(u, u)}" for u in came] + [f"-{u}" for u in gone]))
    apply_rules(a, cfg, out, devices, stamp)
    return cur


class _Stop(Exception):
    """SIGTERM: launchd unloads the agent."""


def _on_term(_sig: int, _frame: object) -> None:
    raise _Stop()


def watch(a: Audio, cfg: Config, out: Out) -> int:
    signal.signal(signal.SIGTERM, _on_term)
    wake = threading.Event()
    pushed = a.listen(wake.set)
    out.msg(f" >>> {now()} watching ({'CoreAudio wakes it; ' if pushed else 'no CoreAudio listener: '}"
            f"re-check every {cfg.recheck:g} s) -- config {cfg.path}")
    prev: frozenset[str] | None = None
    PHASE[0] = "watching the devices"
    try:
        while True:
            prev = watch_step(a, cfg, out, prev)
            if wake.wait(cfg.recheck):
                out.dbg(f"woken by CoreAudio; settling {cfg.settle:g} s")
                time.sleep(cfg.settle)
            wake.clear()
    except _Stop:
        out.msg(f" >>> {now()} stopped (SIGTERM)")
        return 0


def volume_text(a: Audio, dev: Device) -> str:
    v = a.volume(dev.id)
    m = a.muted(dev.id)
    vol = f"volume {round(v * 100)}%" if v is not None else "volume n/a (the device has no main volume)"
    return vol + ("" if m is None else (", muted" if m else ", not muted"))


def launchctl() -> str:
    # the self-test points this at a stub, so no test touches the real launchd
    return os.environ.get("MY_AUDIO_LAUNCHCTL", "") or "/bin/launchctl"


def agent_state(label: str) -> tuple[bool, str]:
    """(loaded, what to say about it) from `launchctl print`."""
    p = subprocess.run([launchctl(), "print", f"gui/{os.getuid()}/{label}"], capture_output=True, text=True)
    if p.returncode != 0:
        return False, f"not loaded ({label}; `{NAME} install`)"
    info: dict[str, str] = {}
    for ln in p.stdout.splitlines():
        k, sep, v = ln.strip().partition(" = ")
        if sep and k in ("state", "pid", "last exit code") and k not in info:
            info[k] = v.strip()
    if info.get("state") == "running":
        return True, f"running [pid {info.get('pid', '?')}] ({label})"
    return True, (f"loaded, {info.get('state', 'not running')} "
                  f"[last exit {info.get('last exit code', '?')}] ({label})")


def status(a: Audio, cfg: Config, out: Out) -> int:
    devices = a.devices()
    cur = by_id(devices, a.default_output())
    dec = decide(cfg.rules, cfg.fallback, devices)
    if cur is None:
        out.msg(" >>> output: none  (CoreAudio has no default output)")
    else:
        if dec.target is None:
            why = dec.why()
        elif dec.target == cur.name:
            why = dec.why()
        elif not any(d.name == dec.target for d in devices):
            why = f"the rules want '{dec.target}', which is not present -- {dec.why()}"
        else:
            why = (f"chosen by hand since the last change, or the agent is not running; "
                   f"the rules want '{dec.target}' -- {dec.why()}")
        out.msg(f" >>> output: {cur.name}  ({why})")
        out.msg(f"    > {volume_text(a, cur)}")
    out.msg(f"    > agent: {agent_state(cfg.label)[1]}")
    out.det(f"    > devices ({len(devices)}; * = the output; config {cfg.path}):")
    for d in devices:
        mark = "*" if cur is not None and d.id == cur.id else " "
        out.det(f"   > {mark} {d.name}  [{d.transport}, {d.outputs} out, uid {d.uid}]")
    return 0


def run(out: Out, *cmd: str) -> subprocess.CompletedProcess[str]:
    """Run a command; under -V it is echoed first, from the same argv."""
    out.det(" >>> " + " ".join(cmd))
    return subprocess.run(list(cmd), capture_output=True, text=True)


INSTALLED_BY = b"<!-- installed by "


def with_installer(data: bytes) -> bytes:
    """The plist with one line after its DOCTYPE saying who installed it,
    when and how -- the line same_plist ignores."""
    import socket
    when = time.strftime("%Y-%m-%d %H:%M %z")
    line = (f"<!-- installed by {NAME} install ({os.environ.get('USER') or os.getuid()}) on "
            f"{socket.gethostname().split('.')[0]}, {when}: generated, build {build_id()} -->").encode()
    head, sep, rest = data.partition(b"<plist ")
    return head + line + b"\n" + sep + rest


def same_plist(new: bytes, old: bytes) -> bool:
    """The same job: equal but for the installer line, which the installed
    one must have -- one without it is installed again."""
    def body(b: bytes) -> list[bytes]:
        return [ln for ln in b.splitlines() if not ln.startswith(INSTALLED_BY)]
    return any(ln.startswith(INSTALLED_BY) for ln in old.splitlines()) and body(new) == body(old)


def plist_path(label: str) -> str:
    return os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")


def install(cfg: Config, out: Out) -> int:
    PHASE[0] = "installing the LaunchAgent"
    log_dir = os.path.dirname(cfg.log_file)
    if not os.path.isdir(log_dir) or not os.access(log_dir, os.W_OK):
        err("00016", f"the log directory '{log_dir}' (LOG_FILE) is missing or not writable for "
                     f"{os.environ.get('USER', os.getuid())} -- create it, or set LOG_FILE")
    tool = os.path.abspath(sys.argv[0])
    args = [sys.executable, tool, "watch"] + (["--config", os.path.abspath(cfg.path)] if cfg.explicit else [])
    data = with_installer(plistlib.dumps({
        "Label": cfg.label,
        "ProgramArguments": args,
        "RunAtLoad": True,
        "KeepAlive": True,
        "LimitLoadToSessionType": "Aqua",
        "StandardOutPath": cfg.log_file,
        "StandardErrorPath": cfg.log_file,
        "ProcessType": "Background",
    }))
    path = plist_path(cfg.label)
    try:
        with open(path, "rb") as f:
            old = f.read()
    except OSError:
        old = b""
    loaded, state = agent_state(cfg.label)
    if same_plist(data, old) and loaded:
        out.msg(f" >>> already installed: {state}")
        out.det(f"    > plist {path} is the one `install` writes now")
        return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)
    target = f"gui/{os.getuid()}"
    if loaded:
        p = run(out, launchctl(), "bootout", f"{target}/{cfg.label}")
        if p.returncode != 0:
            err("00017", f"launchctl bootout {target}/{cfg.label} failed [rc {p.returncode}]: {p.stderr.strip()}")
    p = run(out, launchctl(), "bootstrap", target, path)
    if p.returncode != 0:
        err("00018", f"launchctl bootstrap {target} {path} failed [rc {p.returncode}]: {p.stderr.strip()}")
    why = ("new" if not old else "the plist differed" if not same_plist(data, old)
           else "loaded again: the plist was right, the agent was not loaded")
    out.msg(f" >>> installed {cfg.label}  ({why}; "
            f"plist {path}, log {cfg.log_file})")
    out.det(f"    > runs: {' '.join(args)}")
    out.msg(f"    > agent: {agent_state(cfg.label)[1]}")
    return 0


def uninstall(cfg: Config, out: Out, go: bool) -> int:
    PHASE[0] = "removing the LaunchAgent"
    path = plist_path(cfg.label)
    loaded, _state = agent_state(cfg.label)
    there = os.path.exists(path)
    if not loaded and not there:
        out.msg(f" >>> not installed: no {cfg.label} loaded, no {path} -- nothing to remove")
        return 0
    what = " and ".join(([f"unload {cfg.label}"] if loaded else []) + ([f"remove {path}"] if there else []))
    if not go:
        out.msg(f" >>> would {what}")
        out.msg(f"    > `{NAME} uninstall go` does it")
        return 0
    if loaded:
        p = run(out, launchctl(), "bootout", f"gui/{os.getuid()}/{cfg.label}")
        if p.returncode != 0:
            err("00019", f"launchctl bootout failed [rc {p.returncode}]: {p.stderr.strip()}")
    if there:
        os.remove(path)   # written by `install` alone: nothing hand-made is lost
    out.msg(f" >>> done: {what}")
    return 0


# --------------------------------------------------------------------------
# Version


def build_id() -> str:
    """First 12 hex of this file's own SHA-256: the bytes that run."""
    import hashlib
    try:
        with open(os.path.realpath(__file__), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "unknown"


def _git(*a: str) -> subprocess.CompletedProcess[str]:
    here = os.path.dirname(os.path.realpath(__file__))
    return subprocess.run(["git", "-c", "safe.directory=*", "-C", here, *a],
                          capture_output=True, text=True, timeout=5)


def describe() -> str:
    """git's describe in a checkout of THIS tool's repo, else the stamp."""
    try:
        r = _git("describe", "--tags", "--long")
        if r.returncode == 0 and r.stdout.strip():
            # describe answers about where the file SITS: a copy in a foreign
            # repo gets that repo's tags -- the stamped commit proves the repo
            if SCRIPT_COMMIT and _git("cat-file", "-e", f"{SCRIPT_COMMIT}^{{commit}}").returncode != 0:
                return SCRIPT_RELEASE
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return SCRIPT_RELEASE if SCRIPT_COMMIT else ""


def version_string() -> str:
    build = build_id()
    desc = describe()
    head, _s, sha = desc.rpartition("-g")
    tag, _s2, count = head.rpartition("-")
    if sha and tag and count.isdigit():
        n = int(count)
        if n == 0:
            return f"{NAME} {__version__} ({desc}: the {tag} tag, build {build})"
        return f"{NAME} {__version__}+{n} ({desc}: {n} commit(s) past {tag}, unreleased, build {build})"
    if SCRIPT_COMMIT:
        return f"{NAME} {__version__} (commit {SCRIPT_COMMIT}, no release tag, build {build})"
    return f"{NAME} {__version__} (build {build}, unstamped)"


def stamp_version() -> int:
    """Record HEAD and git's describe in this file, then AMEND that commit.
    After committing, BEFORE pushing; tag afterwards. The stamped sha lags
    HEAD by one: a commit cannot contain its own sha."""
    import re
    path = os.path.realpath(__file__)
    rel = os.path.basename(path)
    if _git("rev-parse", "--git-dir").returncode != 0:
        err("00020", "not a git checkout -- nothing to stamp")
    sha = _git("rev-parse", "--short", "HEAD").stdout.strip()
    if not sha:
        err("00021", "no commit to stamp from")
    if (_git("rev-parse", "--abbrev-ref", "@{upstream}").returncode == 0
            and _git("merge-base", "--is-ancestor", "HEAD", "@{upstream}").returncode == 0):
        err("00022", "HEAD is already pushed -- amending it would rewrite published history; "
                     "commit, stamp, THEN push")
    if not _git("show", "--name-only", "--format=", "HEAD", "--", rel).stdout.strip():
        err("00023", f"HEAD does not touch {rel} -- it is not this file's commit")
    staged = _git("diff", "--cached", "--name-only").stdout.split()
    if staged:
        err("00024", f"something is staged -- the amend would fold it in: {' '.join(staged)}")
    if _git("diff", "--quiet", "--", rel).returncode != 0:
        err("00025", f"{rel} has uncommitted edits -- commit them first")
    desc = _git("describe", "--tags", "--long").stdout.strip()
    with open(path) as f:
        src = f.read()
    new, n1 = re.subn(r'^SCRIPT_COMMIT = .*$', f'SCRIPT_COMMIT = "{sha}"', src, count=1, flags=re.M)
    new, n2 = re.subn(r'^SCRIPT_RELEASE = .*$', f'SCRIPT_RELEASE = "{desc}"', new, count=1, flags=re.M)
    if n1 != 1 or n2 != 1:
        err("00026", "the SCRIPT_COMMIT / SCRIPT_RELEASE lines are not where they should be")
    if new == src:
        sys.stdout.write(f" >>> already stamped with {sha}\n")
        return 0
    tmp = f"{path}.stamp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(new)
    os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)
    if _git("add", "--", rel).returncode != 0 or _git("commit", "--amend", "--no-edit", "--", rel).returncode != 0:
        err("00027", "git add / commit --amend failed")
    head = _git("rev-parse", "--short", "HEAD").stdout.strip()
    sys.stdout.write(f" >>> stamped SCRIPT_COMMIT={sha} SCRIPT_RELEASE={desc or '<no tag yet>'} "
                     f"-- HEAD is now {head} (lags by one: unavoidable)\n")
    return 0


# --------------------------------------------------------------------------
# Command line


def main(argv: Sequence[str]) -> int:
    try:
        return _main(list(argv))
    except KeyboardInterrupt:
        sys.stderr.write(f"\n{NAME}: interrupted (Ctrl-C) while {PHASE[0]} -- nothing after that ran; "
                         f"the output keeps whatever was set before it\n")
        return 130
    except Exception:            # a bug of ours: its trace goes to a file, never to the screen
        return internal_error()


def internal_error() -> int:
    import tempfile
    import traceback
    e = sys.exc_info()[1]
    d = TRACE_DIR[0] or f"/var/log/mine/{os.environ.get('USER') or os.getuid()}"
    if not os.access(d, os.W_OK):
        d = tempfile.gettempdir()
    path = os.path.join(d, f"{NAME}.trace.{time.strftime('%Y%m%dT%H%M%S')}.{os.getpid()}")
    try:
        with open(path, "w") as f:
            f.write(f"{version_string()} while {PHASE[0]}\n")
            traceback.print_exc(file=f)
        where = f"the trace is in {path}"
    except OSError:
        where = "the trace could not be written"
    sys.stderr.write(f"ERROR 00028 [70]: internal error while {PHASE[0]}: "
                     f"{type(e).__name__}: {e} -- {where}\n")
    return 70


def _optarg(args: list[str], i: int, flag: str) -> tuple[str, int]:
    """The value of `--flag=V` or `--flag V`; ('', i) when there is none."""
    a = args[i]
    if a.startswith(flag + "="):
        return a[len(flag) + 1:], i
    if i + 1 < len(args) and not args[i + 1].startswith("-"):
        return args[i + 1], i + 1
    return "", i


def _main(args: list[str]) -> int:
    out = Out()
    config = ""
    verb = ""
    rest: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if verb:
            rest.append(a)
        elif a in ("-h", "--help"):
            sys.stdout.write(USAGE)
            return 0
        elif a == "--version":
            sys.stdout.write(version_string() + "\n")
            return 0
        elif a == "--run-tests":
            return run_tests(args[i + 1] if i + 1 < len(args) else "")
        elif a == "--stamp-version":
            return stamp_version()
        elif a == "--create-config" or a.startswith("--create-config="):
            target, i = _optarg(args, i, "--create-config")
            return create_config(target)
        elif a == "--config" or a.startswith("--config="):
            config, i = _optarg(args, i, "--config")
            if not config:
                err("00029", "--config needs a FILE", 2)
        elif a == "-Q":
            out.quiet = True
        elif a == "-V":
            out.verbose = True
        elif a == "-D":
            out.debug = True
            if i + 1 < len(args) and not args[i + 1].startswith("-") and args[i + 1] not in VERBS:
                out.debug_path = args[i + 1]
                i += 1
        elif a.startswith("-"):
            bare = a.lstrip("-")
            if bare in VERBS:
                err("00030", f"no such option '{a}'; you mean `{NAME} {bare}`", 2)
            if bare == "status":
                err("00031", f"no such option '{a}'; the status is what `{NAME}` shows without a verb", 2)
            err("00032", f"unknown option '{a}' -- `{NAME} -h` lists them", 2)
        else:
            verb = a
        i += 1
    if out.debug:
        out.verbose = True
    if out.verbose:
        out.quiet = False
    if verb == "status":
        err("00033", f"the status is what `{NAME}` shows without a verb", 2)
    if verb and verb not in VERBS:
        err("00034", f"unknown verb '{verb}' -- the verbs are: {', '.join(VERBS)}", 2)
    if rest and not (verb == "uninstall" and rest == ["go"]):
        err("00035", f"'{verb}' takes no argument, got '{' '.join(rest)}'"
                     + (" (only `uninstall go`)" if verb == "uninstall" else ""), 2)
    PHASE[0] = "reading the config"
    path, explicit = find_config(config)
    cfg = load_config(path, explicit)
    out.dbg(f"config {path}: {len(cfg.rules)} rule(s), fallback {cfg.fallback!r}, "
            f"recheck {cfg.recheck:g} s, settle {cfg.settle:g} s, label {cfg.label}")
    if verb == "install":
        return install(cfg, out)
    if verb == "uninstall":
        return uninstall(cfg, out, rest == ["go"])
    PHASE[0] = "reading the audio devices"
    a = audio()
    try:
        if verb == "apply":
            PHASE[0] = "applying the rules"
            return 0 if apply_rules(a, cfg, out, a.devices()) else 1
        if verb == "watch":
            return watch(a, cfg, out)
        return status(a, cfg, out)
    except AudioError as e:
        err("00036", str(e))


# --------------------------------------------------------------------------
# Self-test: TAP -- the plan first, then one ok / not ok line per test


class T:
    """One test's checks, printed beside it; counts across the run."""

    def __init__(self, root: str) -> None:
        self.root = root
        self.passed = 0
        self.failed = 0

    def ok(self, cond: bool, what: str) -> None:
        if cond:
            self.passed += 1
            sys.stdout.write(f"    ok    {what}\n")
        else:
            self.failed += 1
            sys.stdout.write(f"    FAIL  {what}\n")

    def path(self, name: str) -> str:
        return os.path.join(self.root, name)

    def fake(self, devices: list[dict[str, object]], default: int) -> str:
        p = self.path("audio.json")
        with open(p, "w") as f:
            json.dump({"devices": devices, "default": default, "sets": 0}, f)
        return p

    def conf(self, rules: str, fallback: str = "", label: str = "test.my-audio") -> str:
        p = self.path("my-audio.conf")
        with open(p, "w") as f:
            f.write(f"AUDIO_RULES='{rules}'\nOUTPUT_FALLBACK=\"{fallback}\"\nRECHECK_INTERVAL=60\n"
                    f"SETTLE_TIME=0\nLAUNCHD_LABEL=\"{label}\"\nLOG_FILE=\"{self.root}/my-audio.log\"\n")
        return p

    def cfg(self, rules: str, fallback: str = "") -> Config:
        return Config(path="test", explicit=True, rules=parse_rules(rules), fallback=fallback,
                      recheck=60, settle=0, label="test.my-audio", log_file=self.path("log"))

    def cli(self, *args: str, env: dict[str, str] | None = None) -> tuple[int, str, str]:
        e = {**os.environ, "HOME": self.root, "MY_AUDIO_CONFIG": self.path("my-audio.conf"),
             "MY_AUDIO_FAKE": self.path("audio.json"), "MY_AUDIO_LAUNCHCTL": self.stub(), **(env or {})}
        p = subprocess.run([sys.executable, os.path.realpath(__file__), *args], capture_output=True,
                           text=True, env=e, stdin=subprocess.DEVNULL, timeout=60)
        return p.returncode, p.stdout, p.stderr

    def stub(self) -> str:
        """A launchctl that logs its arguments and keeps 'loaded' in a file."""
        p = self.path("launchctl")
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(f'#!/bin/sh\necho "$*" >> "{self.root}/launchctl.log"\n'
                        f'L="{self.root}/loaded"\n'
                        'case $1 in\n'
                        '  print)     [ -e "$L" ] || exit 113; printf "\\tstate = running\\n\\tpid = 42\\n" ;;\n'
                        '  bootstrap) : > "$L" ;;\n'
                        '  bootout)   rm -f "$L" ;;\n'
                        'esac\n')
            os.chmod(p, 0o755)
        return p

    def default(self) -> int:
        with open(self.path("audio.json")) as f:
            v = json.load(f)["default"]
        return int(v)

    def sets(self) -> int:
        with open(self.path("audio.json")) as f:
            v = json.load(f)["sets"]
        return int(v)


def _dev(i: int, name: str, tran: str, outputs: int = 2) -> dict[str, object]:
    return {"id": i, "uid": f"uid-{i}", "name": name, "tran": tran, "outputs": outputs,
            "volume": 0.5, "mute": False}


SPEAKERS = _dev(1, "Speakers", "bltn")
MULTI = _dev(2, "Multi-Output Device", "grup", 0)      # 0 streams, as CoreAudio reports it
HDMI = _dev(3, "Display", "hdmi")
BT = _dev(4, "Speaker BT", "blue")
BT_MIC = _dev(5, "Headset Mic", "blue", 0)
RULES = "\nhdmi:* => @   # a display\nblue:* => Multi-Output Device\n"


def t_rules_parse(t: T) -> None:
    r = parse_rules("# comment\nhdmi:*  =>  @   # play through it\n\nBLUE:Speaker* => Multi-Output Device\n")
    t.ok(len(r) == 2, f"two rules from two rule lines, a comment and a blank [{len(r)}]")
    t.ok(r[0].target == "@" and r[0].text == "hdmi:* => @", f"'@' and the comment stripped [{r[0].text!r}]")
    t.ok(r[1].transport == "blue" and r[1].glob == "Speaker*", "transport lowercased, glob kept")
    t.ok(parse_rules("usb:Name#2 => @")[0].glob == "Name#2", "a '#' inside a name is not a comment")
    for bad, why in (("hdmi:* @", "=>"), ("hmdi:* => @", "unknown transport"), ("hdmi => @", "glob"),
                     ("hdmi:* =>", "no target")):
        try:
            parse_rules(f"usb:* => @\n{bad}")
            t.ok(False, f"'{bad}' is refused")
        except ValueError as e:
            t.ok("line 2" in str(e) and why in str(e), f"'{bad}' refused, naming line 2: {e}")


def t_first_rule_wins(t: T) -> None:
    devs = [device_from_json(d) for d in (SPEAKERS, MULTI, HDMI, BT)]
    d1 = decide(parse_rules(RULES), "", devs)
    t.ok(d1.target == "Display" and d1.rule is not None and d1.rule.index == 1, f"hdmi first: the display [{d1.why()}]")
    d2 = decide(parse_rules("blue:* => Multi-Output Device\nhdmi:* => @"), "", devs)
    t.ok(d2.target == "Multi-Output Device", f"order swapped: the Multi-Output Device [{d2.why()}]")


def t_at_needs_outputs(t: T) -> None:
    mic = Device(5, "uid-5", "Headset Mic", "blue", 0)
    d = decide(parse_rules("blue:* => @"), "", [mic])
    t.ok(d.target is None, f"'@' never picks a device without outputs (a microphone) [{d.why()}]")
    d2 = decide(parse_rules("blue:* => Multi-Output Device"), "", [mic])
    t.ok(d2.target == "Multi-Output Device", "a named target still matches on that device")


