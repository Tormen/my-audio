def run_tests(filt: str) -> int:
    import shutil
    import tempfile
    sel = [(title, fn) for title, fn in TESTS if filt in title]
    if not sel:
        err("00037", f"--run-tests: no test title contains '{filt}'", 2)
    sys.stdout.write(f"1..{len(sel)}\n")
    root = os.path.realpath(tempfile.mkdtemp(prefix=f"{NAME}-tests."))
    passed = failed = 0
    try:
        for k, (title, fn) in enumerate(sel, 1):
            sys.stdout.write(f"== {title}\n")
            d = os.path.join(root, str(k))
            os.mkdir(d)
            t = T(d)
            try:
                fn(t)
            except Exception as e:     # a crashing check is a failure, not the end
                t.ok(False, f"the check crashed: {type(e).__name__}: {e}")
            passed += t.passed
            failed += t.failed
            sys.stdout.write(f"{'ok' if t.failed == 0 else 'not ok'} {k} - {title}\n")
            sys.stdout.flush()
    finally:
        shutil.rmtree(root, ignore_errors=True)
    v = sys.version_info
    sys.stdout.write(f" >>> self-test (python {v.major}.{v.minor}.{v.micro}): {passed} passed, {failed} failed\n")
    return 0 if failed == 0 else 1


